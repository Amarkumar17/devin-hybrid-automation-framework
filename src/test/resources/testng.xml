<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Hybrid Automation Framework Suite" 
       parallel="methods" 
       thread-count="4" 
       data-provider-thread-count="4">
    
    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="Login Tests">
        <classes>
            <class name="com.framework.tests.LoginTest">
                <methods>
                    <include name="testSuccessfulLogin"/>
                    <include name="testInvalidCredentials"/>
                    <include name="testEmptyUsername"/>
                    <include name="testEmptyPassword"/>
                    <include name="testRememberMeFunctionality"/>
                    <include name="testForgotPasswordLink"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Dashboard Tests">
        <classes>
            <class name="com.framework.tests.DashboardTest">
                <methods>
                    <include name="testDashboardDisplay"/>
                    <include name="testWelcomeMessage"/>
                    <include name="testUserMenu"/>
                    <include name="testLogout"/>
                    <include name="testSearch"/>
                    <include name="testNotificationIcon"/>
                    <include name="testSidebarMenu"/>
                    <include name="testPageTitle"/>
                    <include name="testCurrentUrl"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
